{
  "expo": {
    "name": "IAS Tracker",
    "slug": "ias-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "IAS Tracker usa la tua posizione per mostrarti sulla mappa e per registrare le coordinate delle tue segnalazioni."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "IAS Tracker usa la fotocamera per fotografare le piante che vuoi segnalare.",
          "photosPermission": "IAS Tracker accede alle foto per allegarle alle tue segnalazioni.",
          "microphonePermission": false
        }
      ],
      "expo-mail-composer"
    ]
  }
}
