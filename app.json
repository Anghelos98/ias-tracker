{
  "expo": {
    "name": "IAS Tracker",
    "slug": "ias-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.anghelos98.iastracker",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2E7D32",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "io.github.anghelos98.iastracker"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "IAS Tracker usa la tua posizione per mostrarti sulla mappa e per registrare le coordinate delle tue segnalazioni."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "IAS Tracker usa la fotocamera per fotografare le piante che vuoi segnalare.",
          "photosPermission": "IAS Tracker accede alle foto per allegarle alle tue segnalazioni.",
          "microphonePermission": false
        }
      ],
      "expo-mail-composer",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#121212"
          }
        }
      ]
    ],
    "description": "Mappa delle segnalazioni in Italia delle piante esotiche invasive di rilevanza unionale. Gratuita e open source."
  }
}
